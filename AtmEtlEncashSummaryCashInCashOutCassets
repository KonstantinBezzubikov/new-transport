package gpb.atm.etl.encash.lbdataoperations;

import gpb.atm.etl.encash.common.AtmEtlEncashOsDictionary;
import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashTransactionsByIdDto;
import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashmentsDto;
import gpb.atm.etl.encash.dto.lbdto.json.receipts.upperpart.CassetteCountersBefore;
import gpb.atm.etl.encash.dto.rkodto.SummaryCassette;
import lombok.extern.log4j.Log4j2;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.List;

@Component
@Log4j2
public class AtmEtlEncashSummaryCashInCashOutCassets {

    @Autowired
    AtmEtlEncashOsDictionary dictionary;

    /**
     * Summary.Cassettes строим по итоговым аппаратным счетчикам кассет,
     * а не по сумме транзакций.
     *
     * Почему:
     *
     * В таблице инкассации:
     *
     * КАССЕТА | ЗАГРУЖЕНО | ВЫДАНО
     * ВАЛЮТА  | ОСТАЛОСЬ | ПРИНЯТО
     *
     * используются итоговые HardwareCounters:
     *
     * ЗАГРУЖЕНО = Initial
     * ВЫДАНО    = Presented
     * ПРИНЯТО   = Inserted
     * ОСТАЛОСЬ  = Current + Rejected
     *
     * Поэтому транзакции здесь больше не суммируем.
     *
     * Параметр transactions оставлен только для совместимости
     * с текущим вызовом из AtmEtlEncashSummaryMsgBuilder.
     */
    public List<SummaryCassette> getCassets(
            AtmEtlEncashmentsDto encashments,
            String encashmentId,
            List<AtmEtlEncashTransactionsByIdDto> transactions
    ) {
        List<CassetteCountersBefore> cassetteCountersBeforeList =
                encashments.getLbUpperPartReceiptsMap()
                        .get(encashmentId)
                        .getCassettesData()
                        .getCassetteCountersBefore();

        return getCassets(cassetteCountersBeforeList);
    }

    private List<SummaryCassette> getCassets(List<CassetteCountersBefore> cassetteCountersBeforeList) {
        List<SummaryCassette> summaryCassettes = new ArrayList<>();

        if (cassetteCountersBeforeList == null || cassetteCountersBeforeList.isEmpty()) {
            return summaryCassettes;
        }

        for (CassetteCountersBefore cassetteCounters : cassetteCountersBeforeList) {
            if (cassetteCounters == null) {
                continue;
            }

            /*
             * Выбираем только кассеты, которые должны попадать
             * в кассетный Summary / Balance.
             *
             * DepositCassette сюда не включается,
             * она считается отдельно в Summary.Deposit.
             */
            if (!dictionary.findRecycleOrCashout(cassetteCounters)) {
                continue;
            }

            SummaryCassette summaryCassette = new SummaryCassette();

            Integer nominal = nullToZero(dictionary.getNominal(cassetteCounters));
            Integer currencyCode = dictionary.getCurrency(cassetteCounters);

            /*
             * dictionary.getInitialCount(...) в текущем коде уже возвращает сумму,
             * а не количество купюр.
             *
             * Это подтверждается текущим результатом:
             *
             * Initial = 1500, Nominal = 100
             * InitialSum = 150000
             *
             * Значит InitialSum оставляем через существующий метод словаря.
             */
            Integer initialSum = nullToZero(dictionary.getInitialCount(cassetteCounters));

            /*
             * Остальные значения берем как количество купюр
             * из аппаратных счетчиков и умножаем на номинал.
             */
            Integer insertedCount = getInsertedCount(cassetteCounters);
            Integer presentedCount = getPresentedCount(cassetteCounters);
            Integer rejectedCount = getRejectedCount(cassetteCounters);
            Integer currentCount = getCurrentCount(cassetteCounters);

            Integer cashinSum = insertedCount * nominal;
            Integer cashoutSum = presentedCount * nominal;
            Integer remainSum = (currentCount + rejectedCount) * nominal;

            summaryCassette.setSlot(cassetteCounters.getSlot());
            summaryCassette.setCurrencyCode(currencyCode);
            summaryCassette.setNominal(nominal);

            summaryCassette.setInitialSum(initialSum);
            summaryCassette.setCashoutSum(cashoutSum);
            summaryCassette.setCashinSum(cashinSum);
            summaryCassette.setRemainSum(remainSum);

            summaryCassettes.add(summaryCassette);

            log.debug(
                    "SUMMARY CASSETTE: slot={}, currencyCode={}, nominal={}, initialSum={}, cashoutSum={}, cashinSum={}, remainSum={}, " +
                            "insertedCount={}, presentedCount={}, rejectedCount={}, currentCount={}",
                    summaryCassette.getSlot(),
                    summaryCassette.getCurrencyCode(),
                    summaryCassette.getNominal(),
                    summaryCassette.getInitialSum(),
                    summaryCassette.getCashoutSum(),
                    summaryCassette.getCashinSum(),
                    summaryCassette.getRemainSum(),
                    insertedCount,
                    presentedCount,
                    rejectedCount,
                    currentCount
            );
        }

        return summaryCassettes;
    }

    /**
     * Inserted / принято.
     *
     * Для примера:
     *
     * CassetteB:
     * Inserted = 189
     * Nominal = 100
     * CashinSum = 18900
     */
    private Integer getInsertedCount(CassetteCountersBefore cassetteCounters) {
        return getCounterValue(
                cassetteCounters,
                new String[]{
                        "getInserted",
                        "getInsertedCount",
                        "getCashInCount",
                        "getCashinCount",
                        "getCashIn",
                        "getCashin",
                        "getAccepted",
                        "getAcceptedCount"
                },
                new String[]{
                        "Inserted",
                        "InsertedCount",
                        "CashInCount",
                        "CashinCount",
                        "CashIn",
                        "Cashin",
                        "Accepted",
                        "AcceptedCount"
                }
        );
    }

    /**
     * Presented / выдано.
     *
     * Для примера:
     *
     * CassetteB:
     * Presented = 758
     * Nominal = 100
     * CashoutSum = 75800
     */
    private Integer getPresentedCount(CassetteCountersBefore cassetteCounters) {
        return getCounterValue(
                cassetteCounters,
                new String[]{
                        "getPresented",
                        "getPresentedCount",
                        "getDispensed",
                        "getDispensedCount",
                        "getCashOutCount",
                        "getCashoutCount",
                        "getCashOut",
                        "getCashout"
                },
                new String[]{
                        "Presented",
                        "PresentedCount",
                        "Dispensed",
                        "DispensedCount",
                        "CashOutCount",
                        "CashoutCount",
                        "CashOut",
                        "Cashout"
                }
        );
    }

    /**
     * Rejected / reject.
     *
     * Для остатка используется:
     *
     * RemainSum = (Current + Rejected) * Nominal
     */
    private Integer getRejectedCount(CassetteCountersBefore cassetteCounters) {
        return getCounterValue(
                cassetteCounters,
                new String[]{
                        "getRejected",
                        "getRejectedCount",
                        "getReject",
                        "getRejectCount"
                },
                new String[]{
                        "Rejected",
                        "RejectedCount",
                        "Reject",
                        "RejectCount"
                }
        );
    }

    /**
     * Current / осталось в кассете.
     *
     * Для остатка используется:
     *
     * RemainSum = (Current + Rejected) * Nominal
     */
    private Integer getCurrentCount(CassetteCountersBefore cassetteCounters) {
        return getCounterValue(
                cassetteCounters,
                new String[]{
                        "getCurrent",
                        "getCurrentCount"
                },
                new String[]{
                        "Current",
                        "CurrentCount"
                }
        );
    }

    /**
     * Безопасное чтение счетчиков из CassetteCountersBefore.
     *
     * Сделано через reflection, чтобы не менять:
     *
     * - CassetteCountersBefore;
     * - AtmEtlEncashOsDictionary;
     * - AtmEtlEncashHardwareCountersMsgBuilder.
     *
     * Если в DTO геттер называется иначе, достаточно добавить его имя
     * в соответствующий массив выше.
     */
    private Integer getCounterValue(
            CassetteCountersBefore cassetteCounters,
            String[] getterNames,
            String[] fieldNames
    ) {
        if (cassetteCounters == null) {
            return 0;
        }

        Object value = getValueByGetter(cassetteCounters, getterNames);

        if (value == null) {
            value = getValueByField(cassetteCounters, fieldNames);
        }

        return objectToInteger(value);
    }

    private Object getValueByGetter(Object target, String[] getterNames) {
        if (target == null || getterNames == null) {
            return null;
        }

        Class<?> clazz = target.getClass();

        for (String getterName : getterNames) {
            try {
                Method method = clazz.getMethod(getterName);
                method.setAccessible(true);
                Object value = method.invoke(target);

                if (value != null) {
                    return value;
                }
            } catch (Exception ignored) {
                /*
                 * Пробуем следующий getter.
                 */
            }
        }

        return null;
    }

    private Object getValueByField(Object target, String[] fieldNames) {
        if (target == null || fieldNames == null) {
            return null;
        }

        Class<?> clazz = target.getClass();

        for (String fieldName : fieldNames) {
            Object value = getValueByFieldIgnoreCase(clazz, target, fieldName);

            if (value != null) {
                return value;
            }
        }

        return null;
    }

    private Object getValueByFieldIgnoreCase(Class<?> clazz, Object target, String fieldName) {
        if (clazz == null || Object.class.equals(clazz)) {
            return null;
        }

        try {
            for (Field field : clazz.getDeclaredFields()) {
                if (field.getName().equals(fieldName) || field.getName().equalsIgnoreCase(fieldName)) {
                    field.setAccessible(true);
                    return field.get(target);
                }
            }
        } catch (Exception ignored) {
            /*
             * Пробуем родительский класс.
             */
        }

        return getValueByFieldIgnoreCase(clazz.getSuperclass(), target, fieldName);
    }

    private Integer objectToInteger(Object value) {
        if (value == null) {
            return 0;
        }

        if (value instanceof Integer) {
            return (Integer) value;
        }

        if (value instanceof Long) {
            return ((Long) value).intValue();
        }

        if (value instanceof Short) {
            return ((Short) value).intValue();
        }

        if (value instanceof Byte) {
            return ((Byte) value).intValue();
        }

        if (value instanceof Double) {
            return ((Double) value).intValue();
        }

        if (value instanceof Float) {
            return ((Float) value).intValue();
        }

        if (value instanceof Number) {
            return ((Number) value).intValue();
        }

        try {
            return Integer.parseInt(String.valueOf(value));
        } catch (Exception e) {
            return 0;
        }
    }

    private Integer nullToZero(Integer value) {
        return value == null ? 0 : value;
    }
}
