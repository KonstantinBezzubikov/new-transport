package gpb.atm.etl.encash.lbdataoperations;

import gpb.atm.etl.encash.common.AtmEtlEncashOsDictionary;
import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashTransactionsByIdDto;
import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashmentsDto;
import gpb.atm.etl.encash.dto.lbdto.json.receipts.upperpart.CassetteCountersBefore;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.LbEtlEncashCassetInTransactionDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.LbEtlEncashCassetsTransactionsJsonDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.Nominal;
import gpb.atm.etl.encash.dto.rkodto.SummaryCassette;
import gpb.atm.etl.encash.msgrouter.AtmEtlEncashJsonParser;
import lombok.extern.log4j.Log4j2;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;

@Component
@Log4j2
public class AtmEtlEncashSummaryCashInCashOutCassets {

    @Autowired
    AtmEtlEncashOsDictionary dictionary;

    @Autowired
    AtmEtlEncashJsonParser lbEncashJsonParser;

    /**
     * Summary.Cassettes строим не через суммирование всех транзакционных дельт,
     * а через накопительные счетчики из cassettes_after.
     *
     * HardwareCounters здесь НЕ используем.
     *
     * Используем данные самих transactions:
     *
     * - CashInCount / Inserted;
     * - DispensedCount / Presented.
     *
     * Формулы:
     *
     * InitialSum = из верхней части чека, dictionary.getInitialCount(...)
     * CashoutSum = max(DispensedCount) * Nominal
     * CashinSum  = max(CashInCount) * Nominal
     * RemainSum  = InitialSum - CashoutSum + CashinSum
     */
    public List<SummaryCassette> getCassets(
            AtmEtlEncashmentsDto encashments,
            String encashmentId,
            List<AtmEtlEncashTransactionsByIdDto> transactions
    ) {
        List<CassetteCountersBefore> cassetteCountersBeforeList =
                encashments.getLbUpperPartReceiptsMap()
                        .get(encashmentId)
                        .getCassettesData()
                        .getCassetteCountersBefore();

        List<SummaryCassette> cassets = getBaseCassets(cassetteCountersBeforeList);

        fillCashInCashOutFromTransactions(cassets, transactions);

        recalculateRemain(cassets);

        return cassets;
    }

    /**
     * Создаем базовый список кассет из верхней части чека.
     *
     * Здесь задаем:
     *
     * - Slot;
     * - CurrencyCode;
     * - Nominal;
     * - InitialSum;
     * - CashoutSum = 0;
     * - CashinSum = 0;
     * - RemainSum = InitialSum.
     */
    private List<SummaryCassette> getBaseCassets(
            List<CassetteCountersBefore> cassetteCountersBeforeList
    ) {
        List<SummaryCassette> summaryCassettes = new ArrayList<>();

        if (cassetteCountersBeforeList == null || cassetteCountersBeforeList.isEmpty()) {
            return summaryCassettes;
        }

        for (CassetteCountersBefore cassetteCounters : cassetteCountersBeforeList) {
            if (cassetteCounters == null) {
                continue;
            }

            /*
             * В Summary.Cassettes включаем только кассеты,
             * относящиеся к кассетному балансу.
             *
             * DepositCassette сюда не включаем.
             * Deposit считается отдельно в AtmEtlEncashSummaryDeposit.
             */
            if (!dictionary.findRecycleOrCashout(cassetteCounters)) {
                continue;
            }

            SummaryCassette summaryCassette = new SummaryCassette();

            Integer nominal = nullToZero(dictionary.getNominal(cassetteCounters));
            Integer currencyCode = dictionary.getCurrency(cassetteCounters);
            Integer initialSum = nullToZero(dictionary.getInitialCount(cassetteCounters));

            summaryCassette.setSlot(cassetteCounters.getSlot());
            summaryCassette.setCurrencyCode(currencyCode);
            summaryCassette.setNominal(nominal);

            summaryCassette.setInitialSum(initialSum);
            summaryCassette.setCashoutSum(0);
            summaryCassette.setCashinSum(0);
            summaryCassette.setRemainSum(initialSum);

            summaryCassettes.add(summaryCassette);
        }

        return summaryCassettes;
    }

    /**
     * Заполняем CashinSum / CashoutSum из transactions.cassettes_after.
     *
     * Важно:
     *
     * НЕ суммируем все операции.
     *
     * Берем максимальные накопительные счетчики:
     *
     * - max(CashInCount);
     * - max(DispensedCount).
     *
     * Это исправляет завышение вида:
     *
     * CashinSum = 77900 вместо 18900.
     */
    private void fillCashInCashOutFromTransactions(
            List<SummaryCassette> cassets,
            List<AtmEtlEncashTransactionsByIdDto> transactions
    ) {
        if (cassets == null || cassets.isEmpty()) {
            return;
        }

        if (transactions == null || transactions.isEmpty()) {
            return;
        }

        for (AtmEtlEncashTransactionsByIdDto transaction : transactions) {
            if (transaction == null) {
                continue;
            }

            List<LbEtlEncashCassetInTransactionDto> cassetsAfter =
                    getCassetsList(getCassetsAfterTransData(transaction));

            if (cassetsAfter.isEmpty()) {
                continue;
            }

            for (LbEtlEncashCassetInTransactionDto cassetAfter : cassetsAfter) {
                if (cassetAfter == null) {
                    continue;
                }

                normalizeNominals(cassetAfter);

                if (cassetAfter.getNominals().isEmpty()) {
                    continue;
                }

                for (Nominal nominal : cassetAfter.getNominals()) {
                    if (nominal == null) {
                        continue;
                    }

                    SummaryCassette summaryCassette =
                            findSummaryCassette(cassets, cassetAfter, nominal);

                    if (summaryCassette == null) {
                        continue;
                    }

                    updateCashInCashOut(summaryCassette, nominal);
                }
            }
        }
    }

    /**
     * Обновляем суммы по кассете.
     *
     * Используем max, потому что CashInCount / DispensedCount
     * в cassettes_after являются накопительными счетчиками.
     */
    private void updateCashInCashOut(
            SummaryCassette summaryCassette,
            Nominal nominal
    ) {
        Integer nominalValue = nullToZero(summaryCassette.getNominal());

        if (nominalValue == 0) {
            return;
        }

        Integer cashInCount = nullToZero(nominal.getCashInCount());
        Integer dispensedCount = nullToZero(nominal.getDispensedCount());

        Integer currentCashInCount = nullToZero(summaryCassette.getCashinSum()) / nominalValue;
        Integer currentCashOutCount = nullToZero(summaryCassette.getCashoutSum()) / nominalValue;

        if (cashInCount > currentCashInCount) {
            summaryCassette.setCashinSum(cashInCount * nominalValue);
        }

        if (dispensedCount > currentCashOutCount) {
            summaryCassette.setCashoutSum(dispensedCount * nominalValue);
        }
    }

    /**
     * Остаток считаем по кассетной формуле:
     *
     * RemainSum = InitialSum - CashoutSum + CashinSum
     *
     * Это соответствует:
     *
     * RemainSum = (Current + Rejected) * Nominal
     *
     * но не требует отдельно брать Current / Rejected.
     */
    private void recalculateRemain(List<SummaryCassette> cassets) {
        if (cassets == null || cassets.isEmpty()) {
            return;
        }

        for (SummaryCassette summaryCassette : cassets) {
            if (summaryCassette == null) {
                continue;
            }

            Integer initialSum = nullToZero(summaryCassette.getInitialSum());
            Integer cashoutSum = nullToZero(summaryCassette.getCashoutSum());
            Integer cashinSum = nullToZero(summaryCassette.getCashinSum());

            summaryCassette.setRemainSum(initialSum - cashoutSum + cashinSum);
        }
    }

    /**
     * Ищем SummaryCassette по slot + nominal + currency.
     */
    private SummaryCassette findSummaryCassette(
            List<SummaryCassette> cassets,
            LbEtlEncashCassetInTransactionDto cassetAfter,
            Nominal nominal
    ) {
        if (cassets == null || cassets.isEmpty()) {
            return null;
        }

        Integer transactionNominal =
                dictionary.getOsNominalValue(nominal.getNominalId());

        Integer transactionCurrencyCode =
                dictionary.getCurrencyCode(nominal.getNominalId());

        for (SummaryCassette summaryCassette : cassets) {
            if (summaryCassette == null) {
                continue;
            }

            if (!safeEquals(summaryCassette.getSlot(), cassetAfter.getSlot())) {
                continue;
            }

            if (transactionNominal != null
                    && !transactionNominal.equals(summaryCassette.getNominal())) {
                continue;
            }

            if (transactionCurrencyCode != null
                    && !transactionCurrencyCode.equals(summaryCassette.getCurrencyCode())) {
                continue;
            }

            return summaryCassette;
        }

        return null;
    }

    private LbEtlEncashCassetsTransactionsJsonDto getCassetsAfterTransData(
            AtmEtlEncashTransactionsByIdDto transaction
    ) {
        return lbEncashJsonParser.parse(
                correctTransJson(transaction.getCassettesAfterJson()),
                LbEtlEncashCassetsTransactionsJsonDto.class
        );
    }

    private List<LbEtlEncashCassetInTransactionDto> getCassetsList(
            LbEtlEncashCassetsTransactionsJsonDto dto
    ) {
        if (dto == null || dto.getCassetsTransactionsJson() == null) {
            return new ArrayList<>();
        }

        return dto.getCassetsTransactionsJson();
    }

    private String correctTransJson(String json) {
        if (json == null || json.trim().isEmpty() || "null".equalsIgnoreCase(json.trim())) {
            return "{\"CassetsTransactions\":[]}";
        }

        return "{\"CassetsTransactions\":" + json + "}";
    }

    private void normalizeNominals(LbEtlEncashCassetInTransactionDto casset) {
        if (casset.getNominals() == null) {
            casset.setNominals(new ArrayList<>());
        }
    }

    private boolean safeEquals(Object first, Object second) {
        if (first == null) {
            return second == null;
        }

        return first.equals(second);
    }

    private Integer nullToZero(Integer value) {
        return value == null ? 0 : value;
    }
}
