package gpb.atm.etl.encash.lbdataoperations;

import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashTransactionsByIdDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.LbEtlEncashCassetInTransactionDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.LbEtlEncashCassetsTransactionsJsonDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.Nominal;
import gpb.atm.etl.encash.msgrouter.AtmEtlEncashJsonParser;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;

@Component
public class AtmEtlEncashTransactionsCounter {

    /**
     * Presented - выдано.
     */
    private static final String TRANSACTION_TYPE_PRESENTED = "Presented";

    /**
     * Accepted - принято.
     */
    private static final String TRANSACTION_TYPE_ACCEPTED = "Accepted";

    /**
     * currencyExchange - валютообмен.
     *
     * В рамках одной операции валютообмена может быть два движения:
     *
     * 1. Прием валюты.
     * 2. Выдача рублей.
     *
     * Для currencyExchange нельзя считать только одну чистую дельту
     * after - before, потому что по одному номиналу/кассете могут быть
     * одновременно:
     *
     * - CashInCount / Inserted;
     * - DispensedCount / Presented.
     *
     * Также нельзя брать CashInCount / DispensedCount только из after,
     * потому что эти счетчики могут быть накопительными.
     *
     * Правильно:
     *
     * cashInDelta    = after.CashInCount    - before.CashInCount
     * dispensedDelta = after.DispensedCount - before.DispensedCount
     *
     * После этого формируем отдельные движения:
     *
     * +cashInDelta      - принято;
     * -dispensedDelta   - выдано.
     */
    private static final String TRANSACTION_TYPE_CURRENCY_EXCHANGE = "currencyExchange";

    // private static final Logger log = LogManager.getLogger(LbEtlEncashTransactionsCounter.class);

    @Autowired
    AtmEtlEncashJsonParser lbEncashJsonParser;

    public void getTransactionSumm(List<AtmEtlEncashTransactionsByIdDto> transactions) throws Exception {
        // Транзакции с данными об изменении счетчиков в кассетах:
        // HashMap<transId, List<HashMap<casseteId, summ>>>
        // HashMap<String, List<LbEncashCasseteNominalCounter>> trans = new HashMap<>();

        try {
            if (transactions != null && !transactions.isEmpty()) {
                for (AtmEtlEncashTransactionsByIdDto transaction : transactions) {
                    List<AtmEtlEncashCasseteNominalCounter> cassetsList = new ArrayList<>();

                    // log.info("");
                    // log.info("transaction counter: " + transaction.getId());

                    /**
                     * Данные по кассетам на начало транзакции.
                     */
                    List<LbEtlEncashCassetInTransactionDto> cassetsTransactionsBeforeList =
                            getCassetsList(getCassetsBeforeTransData(transaction));

                    /**
                     * Данные по кассетам на конец транзакции.
                     */
                    List<LbEtlEncashCassetInTransactionDto> cassetsTransactionsAfterList =
                            getCassetsList(getCassetsAfterTransData(transaction));

                    /**
                     * Если данных по кассетам не существует,
                     * то создаем новый пустой массив для данных.
                     */
                    if (cassetsTransactionsAfterList == null) {
                        cassetsTransactionsAfterList = new ArrayList<>();
                    }

                    if (cassetsTransactionsBeforeList == null) {
                        cassetsTransactionsBeforeList = new ArrayList<>();
                    }

                    /**
                     * Ищем и добавляем в json отсутствующие кассеты.
                     *
                     * Если кассета есть только в before или только в after,
                     * добавляем ее во второй список с нулевыми номиналами,
                     * чтобы расчет разницы не терял кассеты.
                     */
                    addCassets(cassetsTransactionsBeforeList, cassetsTransactionsAfterList);

                    /**
                     * Перебираем кассеты до начала транзакции.
                     */
                    for (LbEtlEncashCassetInTransactionDto cassetBefore : cassetsTransactionsBeforeList) {

                        /**
                         * Перебираем кассеты на конец транзакции.
                         */
                        for (LbEtlEncashCassetInTransactionDto cassetAfter : cassetsTransactionsAfterList) {

                            /**
                             * Находим одну и ту же кассету до и после.
                             */
                            if (isSameCassette(cassetBefore, cassetAfter)) {

                                /**
                                 * Проверяем на наличие значений с номиналами.
                                 *
                                 * Если в before и after набор номиналов отличается,
                                 * добавляем отсутствующие номиналы с нулевыми счетчиками.
                                 */
                                normalizeNominals(cassetBefore, cassetAfter);

                                /**
                                 * Перебираем номиналы, доступные для текущей кассеты.
                                 */
                                for (Nominal nominalBefore : cassetBefore.getNominals()) {
                                    for (Nominal nominalAfter : cassetAfter.getNominals()) {

                                        /**
                                         * Находим один и тот же номинал до и после.
                                         */
                                        if (safeEquals(nominalBefore.getNominalId(), nominalAfter.getNominalId())) {
                                            AtmEtlEncashMathMetodByCasseteType mathMetodData =
                                                    buildMathMethodData(
                                                            transaction,
                                                            cassetAfter,
                                                            nominalBefore,
                                                            nominalAfter
                                                    );

                                            /**
                                             * Определяем метод расчета в зависимости от типа транзакции
                                             * и вычисляем изменение в кассете за период транзакции по номиналу.
                                             *
                                             * Для старых типов транзакций возвращается один counter.
                                             *
                                             * Для currencyExchange может вернуться два counter:
                                             *
                                             * +N - принято;
                                             * -N - выдано.
                                             */
                                            List<AtmEtlEncashCasseteNominalCounter> countersByNominal =
                                                    getMathMetodByCasseteType(
                                                            mathMetodData,
                                                            nominalBefore,
                                                            nominalAfter
                                                    );

                                            cassetsList.addAll(countersByNominal);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    /**
                     * Сохраняем рассчитанные счетчики кассет и номиналов
                     * в текущую транзакцию.
                     */
                    transaction.setCasseteNominalCounter(cassetsList);

                    // log.info("CasseteNominalCounter: " + cassetsList);
                }
            }

            // return trans;

        } catch (Exception e) {
            e.printStackTrace();
            throw new Exception("Transactions build error: " + e.getMessage());
        }
    }

    private AtmEtlEncashMathMetodByCasseteType buildMathMethodData(
            AtmEtlEncashTransactionsByIdDto transaction,
            LbEtlEncashCassetInTransactionDto cassetAfter,
            Nominal nominalBefore,
            Nominal nominalAfter
    ) {
        AtmEtlEncashMathMetodByCasseteType data = new AtmEtlEncashMathMetodByCasseteType();

        /**
         * Тип транзакции:
         *
         * - Presented;
         * - Accepted;
         * - currencyExchange.
         */
        data.setTransactionType(transaction.getTt());

        /**
         * Значения на момент начала транзакции
         * для текущего номинала.
         */
        data.setCurrentCountBefore(nullToZero(nominalBefore.getCurrentCount()));
        data.setRejectedCountBefore(nullToZero(nominalBefore.getRejectedCount()));

        /**
         * Значения на момент окончания транзакции
         * для текущего номинала.
         */
        data.setCurrentCountAfter(nullToZero(nominalAfter.getCurrentCount()));
        data.setRejectedCountAfter(nullToZero(nominalAfter.getRejectedCount()));

        /**
         * Технические идентификаторы кассеты и номинала.
         */
        data.setNominalId(nominalAfter.getNominalId());
        data.setCassetteId(cassetAfter.getCassetteId());
        data.setCassetteType(cassetAfter.getCassetteType());
        data.setSlot(cassetAfter.getSlot());

        return data;
    }

    private boolean isSameCassette(
            LbEtlEncashCassetInTransactionDto cassetBefore,
            LbEtlEncashCassetInTransactionDto cassetAfter
    ) {
        return safeEquals(cassetAfter.getCassetteId(), cassetBefore.getCassetteId())
                && safeEquals(cassetAfter.getSlot(), cassetBefore.getSlot());
    }

    /**
     * Приводит набор номиналов before/after к сопоставимому виду.
     *
     * Первоначальный код учитывал вырожденные случаи,
     * когда номинал есть только в before или только в after.
     *
     * Здесь эта логика сохранена и усилена:
     *
     * - сравниваем не только размер списков;
     * - сравниваем фактическое наличие nominalId;
     * - если номинал отсутствует, добавляем его с нулевыми счетчиками.
     */
    private void normalizeNominals(
            LbEtlEncashCassetInTransactionDto cassetBefore,
            LbEtlEncashCassetInTransactionDto cassetAfter
    ) {
        if (cassetBefore.getNominals() == null) {
            cassetBefore.setNominals(new ArrayList<>());
        }

        if (cassetAfter.getNominals() == null) {
            cassetAfter.setNominals(new ArrayList<>());
        }

        /**
         * Если в after есть номинал, которого нет в before,
         * добавляем его в before с нулевыми счетчиками.
         *
         * После этого расчет будет:
         *
         * before = 0
         * after  = фактическое значение
         *
         * То есть изменение будет положительным,
         * а не будет интерпретировано как выдача.
         */
        addMissingNominals(
                cassetAfter.getNominals(),
                cassetBefore.getNominals()
        );

        /**
         * Если в before есть номинал, которого нет в after,
         * добавляем его в after с нулевыми счетчиками.
         *
         * После этого расчет будет:
         *
         * before = фактическое значение
         * after  = 0
         *
         * То есть изменение будет отрицательным.
         */
        addMissingNominals(
                cassetBefore.getNominals(),
                cassetAfter.getNominals()
        );
    }

    private LbEtlEncashCassetsTransactionsJsonDto getCassetsBeforeTransData(
            AtmEtlEncashTransactionsByIdDto transaction
    ) {
        return lbEncashJsonParser.parse(
                correctTransJson(transaction.getCassettesBeforeJson()),
                LbEtlEncashCassetsTransactionsJsonDto.class
        );
    }

    private LbEtlEncashCassetsTransactionsJsonDto getCassetsAfterTransData(
            AtmEtlEncashTransactionsByIdDto transaction
    ) {
        return lbEncashJsonParser.parse(
                correctTransJson(transaction.getCassettesAfterJson()),
                LbEtlEncashCassetsTransactionsJsonDto.class
        );
    }

    private List<LbEtlEncashCassetInTransactionDto> getCassetsList(
            LbEtlEncashCassetsTransactionsJsonDto dto
    ) {
        if (dto == null || dto.getCassetsTransactionsJson() == null) {
            return new ArrayList<>();
        }

        return dto.getCassetsTransactionsJson();
    }

    private String correctTransJson(String json) {
        if (json == null || json.trim().isEmpty() || "null".equalsIgnoreCase(json.trim())) {
            return "{\"CassetsTransactions\":[]}";
        }

        return "{\"CassetsTransactions\":" + json + "}";
    }

    /**
     * Добавление недостающих кассет.
     *
     * В первоначальном коде уже была идея:
     * если кассета есть только в одном списке,
     * добавить ее во второй список с нулевыми номиналами.
     *
     * Здесь сохраняем эту механику, но исправляем слабые места:
     *
     * 1. Сравниваем не только размер списков, а наличие конкретного slot.
     * 2. Если размеры одинаковые, но состав кассет разный, это тоже обработается.
     * 3. Не переиспользуем объект по ссылке, а создаем копию с нулевыми счетчиками.
     */
    private List<String> addCassets(
            List<LbEtlEncashCassetInTransactionDto> cassetsTransactionsBeforeJsons,
            List<LbEtlEncashCassetInTransactionDto> cassetsTransactionsAfterJsons
    ) {
        List<String> addedSlots = new ArrayList<>();

        /**
         * Добавляем в after кассеты, которые есть в before,
         * но отсутствуют в after.
         */
        addMissingCassets(
                cassetsTransactionsBeforeJsons,
                cassetsTransactionsAfterJsons,
                addedSlots
        );

        /**
         * Добавляем в before кассеты, которые есть в after,
         * но отсутствуют в before.
         */
        addMissingCassets(
                cassetsTransactionsAfterJsons,
                cassetsTransactionsBeforeJsons,
                addedSlots
        );

        return addedSlots;
    }

    private void addMissingCassets(
            List<LbEtlEncashCassetInTransactionDto> source,
            List<LbEtlEncashCassetInTransactionDto> target,
            List<String> addedSlots
    ) {
        if (source == null || target == null) {
            return;
        }

        for (LbEtlEncashCassetInTransactionDto sourceCasset : source) {
            if (!containsCassetteBySlot(target, sourceCasset.getSlot())) {
                target.add(createZeroCountersCassetCopy(sourceCasset));
                addedSlots.add(sourceCasset.getSlot());
            }
        }
    }

    private boolean containsCassetteBySlot(
            List<LbEtlEncashCassetInTransactionDto> cassettes,
            String slot
    ) {
        if (cassettes == null) {
            return false;
        }

        for (LbEtlEncashCassetInTransactionDto casset : cassettes) {
            if (safeEquals(slot, casset.getSlot())) {
                return true;
            }
        }

        return false;
    }

    /**
     * Создает новую кассету-копию с такими же идентификаторами,
     * но с нулевыми счетчиками номиналов.
     *
     * Это безопаснее, чем:
     *
     * LbEtlEncashCassetInTransactionDto obj = casset;
     *
     * потому что такой код копирует только ссылку,
     * и можно случайно обнулить исходную кассету.
     */
    private LbEtlEncashCassetInTransactionDto createZeroCountersCassetCopy(
            LbEtlEncashCassetInTransactionDto sourceCasset
    ) {
        LbEtlEncashCassetInTransactionDto obj = new LbEtlEncashCassetInTransactionDto();

        obj.setCassetteId(sourceCasset.getCassetteId());
        obj.setCassetteType(sourceCasset.getCassetteType());
        obj.setSlot(sourceCasset.getSlot());
        obj.setNominals(setNominalsForNewObj(sourceCasset.getNominals()));

        return obj;
    }

    /**
     * Добавляет отсутствующие номиналы из source в target.
     *
     * source - список, где номинал есть.
     * target - список, куда нужно добавить отсутствующий номинал с нулями.
     */
    private void addMissingNominals(
            List<Nominal> source,
            List<Nominal> target
    ) {
        if (source == null || target == null) {
            return;
        }

        for (Nominal sourceNominal : source) {
            if (!containsNominalById(target, sourceNominal.getNominalId())) {
                target.add(createZeroCountersNominalCopy(sourceNominal));
            }
        }
    }

    private boolean containsNominalById(
            List<Nominal> nominals,
            Integer nominalId
    ) {
        if (nominals == null) {
            return false;
        }

        for (Nominal nominal : nominals) {
            if (safeEquals(nominalId, nominal.getNominalId())) {
                return true;
            }
        }

        return false;
    }

    /**
     * Добавляет отсутствующие номиналы в уже существующую кассету.
     *
     * Оставлено как отдельный метод, потому что такая механика была
     * в первоначальном коде.
     *
     * nominalsMin - список с меньшим количеством номиналов.
     * nominalsMax - список с большим количеством номиналов.
     */
    private void setNominalsForExistingCasset(List<Nominal> nominalsMin, List<Nominal> nominalsMax) {
        addMissingNominals(nominalsMax, nominalsMin);
    }

    /**
     * Создает новый список номиналов с такими же nominalId,
     * но со всеми счетчиками, равными 0.
     */
    private List<Nominal> setNominalsForNewObj(List<Nominal> nominals) {
        List<Nominal> newList = new ArrayList<>();

        if (nominals == null) {
            return newList;
        }

        // log.info("List<Nominal> nominals" + nominals.toString());

        for (Nominal nominal : nominals) {
            newList.add(createZeroCountersNominalCopy(nominal));
        }

        return newList;
    }

    private Nominal createZeroCountersNominalCopy(Nominal nominal) {
        Nominal obj = new Nominal();

        obj.setNominalId(nominal.getNominalId());
        obj.setCurrentCount(0);
        obj.setCashInCount(0);
        obj.setDispensedCount(0);
        obj.setRejectedCount(0);
        obj.setRetractedCount(0);
        obj.setInitialCount(0);

        return obj;
    }

    /**
     * Presented - выдано.
     * Accepted - принято.
     *
     * Количество выданных считается как разность между количеством до и после
     * по каждому номиналу каждого слота, где:
     *
     * Количество до:
     * cassettes_before[<slot>][<nominal>]['CurrentCount']
     * +
     * cassettes_before[<slot>][<nominal>]['RejectedCount']
     *
     * Количество после:
     * cassettes_after[<slot>][<nominal>]['CurrentCount']
     * +
     * cassettes_after[<slot>][<nominal>]['RejectedCount']
     *
     * Количество принятых считается как разность между количеством после и до
     * по каждому номиналу каждого слота, где:
     *
     * Количество до:
     * cassettes_before[<slot>][<nominal>]['CurrentCount']
     *
     * Количество после:
     * cassettes_after[<slot>][<nominal>]['CurrentCount']
     *
     * Для currencyExchange используется отдельная логика:
     *
     * - CashInCount / Inserted дает положительный counter;
     * - DispensedCount / Presented дает отрицательный counter.
     */
    private List<AtmEtlEncashCasseteNominalCounter> getMathMetodByCasseteType(
            AtmEtlEncashMathMetodByCasseteType data,
            Nominal nominalBefore,
            Nominal nominalAfter
    ) {
        if (TRANSACTION_TYPE_CURRENCY_EXCHANGE.equals(data.getTransactionType())) {
            return getCurrencyExchangeCounters(data, nominalBefore, nominalAfter);
        }

        List<AtmEtlEncashCasseteNominalCounter> result = new ArrayList<>();

        Integer cassettesBefore = 0;
        Integer cassettesAfter = 0;

        if (TRANSACTION_TYPE_PRESENTED.equals(data.getTransactionType())) {
            cassettesBefore = data.getCurrentCountBefore() + data.getRejectedCountBefore();
            cassettesAfter = data.getCurrentCountAfter() + data.getRejectedCountAfter();
        }

        if (TRANSACTION_TYPE_ACCEPTED.equals(data.getTransactionType())) {
            cassettesBefore = data.getCurrentCountBefore();
            cassettesAfter = data.getCurrentCountAfter();
        }

        /**
         * Сохраняем старый инвариант:
         * на каждый обработанный номинал возвращается counter,
         * даже если разница равна 0.
         */
        result.add(
                buildCounter(
                        data,
                        cassettesAfter - cassettesBefore
                )
        );

        return result;
    }

    /**
     * currencyExchange - валютообмен.
     *
     * Для currencyExchange нельзя считать только одну чистую дельту,
     * потому что в одной операции может быть одновременно:
     *
     * - прием валюты;
     * - выдача рублей.
     *
     * Также нельзя брать CashInCount / DispensedCount только из after,
     * потому что эти счетчики могут быть накопительными.
     *
     * Правильно:
     *
     * cashInDelta    = after.CashInCount    - before.CashInCount
     * dispensedDelta = after.DispensedCount - before.DispensedCount
     *
     * Пример:
     *
     * before.DispensedCount = 3
     * after.DispensedCount  = 6
     *
     * dispensedDelta = 6 - 3 = 3
     *
     * Значит выдано 3 купюры, а не 6.
     *
     * Пример результата:
     *
     * Nominal = 100
     * cashInDelta = 2
     * dispensedDelta = 3
     *
     * +2  -> CashinSum  = 200
     * -3  -> CashoutSum = 300
     *
     * Если аппаратные счетчики отсутствуют,
     * используем fallback через старую дельту before/after.
     */
    private List<AtmEtlEncashCasseteNominalCounter> getCurrencyExchangeCounters(
            AtmEtlEncashMathMetodByCasseteType data,
            Nominal nominalBefore,
            Nominal nominalAfter
    ) {
        List<AtmEtlEncashCasseteNominalCounter> result = new ArrayList<>();

        int cashInDelta =
                nullToZero(nominalAfter.getCashInCount())
                        - nullToZero(nominalBefore.getCashInCount());

        int dispensedDelta =
                nullToZero(nominalAfter.getDispensedCount())
                        - nullToZero(nominalBefore.getDispensedCount());

        /**
         * Приемная часть валютообмена.
         */
        if (cashInDelta > 0) {
            result.add(buildCounter(data, cashInDelta));
        }

        /**
         * Выдачная часть валютообмена.
         */
        if (dispensedDelta > 0) {
            result.add(buildCounter(data, -dispensedDelta));
        }

        if (!result.isEmpty()) {
            return result;
        }

        /**
         * Fallback для случаев, когда аппаратные счетчики движения
         * отсутствуют или не заполнены.
         */
        int acceptedBefore = data.getCurrentCountBefore();
        int acceptedAfter = data.getCurrentCountAfter();
        int acceptedDelta = acceptedAfter - acceptedBefore;

        int presentedBefore = data.getCurrentCountBefore() + data.getRejectedCountBefore();
        int presentedAfter = data.getCurrentCountAfter() + data.getRejectedCountAfter();
        int presentedDelta = presentedAfter - presentedBefore;

        if (acceptedDelta > 0) {
            result.add(buildCounter(data, acceptedDelta));
            return result;
        }

        if (presentedDelta < 0) {
            result.add(buildCounter(data, presentedDelta));
            return result;
        }

        /**
         * Сохраняем старый инвариант:
         * на обработанный номинал возвращается counter,
         * даже если изменения нет.
         */
        result.add(buildCounter(data, 0));

        return result;
    }

    private AtmEtlEncashCasseteNominalCounter buildCounter(
            AtmEtlEncashMathMetodByCasseteType data,
            Integer currentCount
    ) {
        return AtmEtlEncashCasseteNominalCounter.builder()
                .currentCount(nullToZero(currentCount))
                .nominalId(data.getNominalId())
                .cassetteType(data.getCassetteType())
                .cassetteId(data.getCassetteId())
                .slot(data.getSlot())
                .build();
    }

    private boolean safeEquals(Object first, Object second) {
        if (first == null) {
            return second == null;
        }

        return first.equals(second);
    }

    private Integer nullToZero(Integer value) {
        return value == null ? 0 : value;
    }
}
