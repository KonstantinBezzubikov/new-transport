package gpb.atm.etl.encash.lbdataoperations;

import gpb.atm.etl.encash.common.AtmEtlEncashOsDictionary;
import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashTransactionsByIdDto;
import gpb.atm.etl.encash.dto.lbdto.AtmEtlEncashmentsDto;
import gpb.atm.etl.encash.dto.lbdto.json.receipts.upperpart.CassetteCountersBefore;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.LbEtlEncashCassetInTransactionDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.LbEtlEncashCassetsTransactionsJsonDto;
import gpb.atm.etl.encash.dto.lbdto.json.transactions.Nominal;
import gpb.atm.etl.encash.dto.rkodto.SummaryCassette;
import gpb.atm.etl.encash.msgrouter.AtmEtlEncashJsonParser;
import lombok.extern.log4j.Log4j2;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.List;

@Component
@Log4j2
public class AtmEtlEncashSummaryCashInCashOutCassets {

    private static final String TRANSACTION_TYPE_PRESENTED = "Presented";
    private static final String TRANSACTION_TYPE_ACCEPTED = "Accepted";
    private static final String TRANSACTION_TYPE_CURRENCY_EXCHANGE = "currencyExchange";

    @Autowired
    AtmEtlEncashOsDictionary dictionary;

    @Autowired
    AtmEtlEncashJsonParser lbEncashJsonParser;

    /**
     * Summary.Cassettes.
     *
     * InitialSum:
     *   из верхней части чека через dictionary.getInitialCount(...).
     *
     * CashOutSum:
     *   НЕ меняем.
     *   Считаем по уже рассчитанным transaction.getCasseteNominalCounter().
     *
     * CashInSum:
     *   считаем не через max(CashInCount), а через дельту:
     *
     *   after.CashInCount - before.CashInCount
     *
     *   по каждой конкретной транзакции.
     *
     * HardwareCounters:
     *   не используем.
     */
    public List<SummaryCassette> getCassets(
            AtmEtlEncashmentsDto encashments,
            String encashmentId,
            List<AtmEtlEncashTransactionsByIdDto> transactions
    ) {
        List<CassetteCountersBefore> cassetteCountersBeforeList =
                encashments.getLbUpperPartReceiptsMap()
                        .get(encashmentId)
                        .getCassettesData()
                        .getCassetteCountersBefore();

        List<SummaryCassette> cassets = getBaseCassets(cassetteCountersBeforeList);

        if (transactions != null && !transactions.isEmpty()) {
            /*
             * CashOut оставляем по старому рабочему принципу:
             * из уже рассчитанных transaction counters.
             */
            fillCashOutOldWay(cassets, transactions);

            /*
             * CashIn исправляем:
             * считаем только по дельтам CashInCount внутри транзакций.
             */
            fillCashInByCashInDelta(cassets, transactions);
        }

        /*
         * После раздельного расчета CashOut и CashIn
         * пересчитываем остаток.
         */
        recalculateRemain(cassets);

        return cassets;
    }

    /**
     * Создаем базовый список кассет из верхней части чека.
     *
     * Здесь заполняем:
     *
     * - Slot;
     * - CurrencyCode;
     * - Nominal;
     * - InitialSum;
     * - CashoutSum = 0;
     * - CashinSum = 0;
     * - RemainSum = InitialSum.
     */
    private List<SummaryCassette> getBaseCassets(
            List<CassetteCountersBefore> cassetteCountersBeforeList
    ) {
        List<SummaryCassette> summaryCassettes = new ArrayList<>();

        if (cassetteCountersBeforeList == null || cassetteCountersBeforeList.isEmpty()) {
            return summaryCassettes;
        }

        for (CassetteCountersBefore cassetteCounters : cassetteCountersBeforeList) {
            if (cassetteCounters == null) {
                continue;
            }

            /*
             * В Summary.Cassettes включаем только кассеты,
             * относящиеся к кассетному балансу.
             *
             * DepositCassette сюда не включается.
             * Deposit считается отдельно в AtmEtlEncashSummaryDeposit.
             */
            if (!dictionary.findRecycleOrCashout(cassetteCounters)) {
                continue;
            }

            SummaryCassette summaryCassette = new SummaryCassette();

            Integer nominal = nullToZero(dictionary.getNominal(cassetteCounters));
            Integer currencyCode = dictionary.getCurrency(cassetteCounters);
            Integer initialSum = nullToZero(dictionary.getInitialCount(cassetteCounters));

            summaryCassette.setSlot(cassetteCounters.getSlot());
            summaryCassette.setCurrencyCode(currencyCode);
            summaryCassette.setNominal(nominal);

            summaryCassette.setInitialSum(initialSum);
            summaryCassette.setCashoutSum(0);
            summaryCassette.setCashinSum(0);
            summaryCassette.setRemainSum(initialSum);

            summaryCassettes.add(summaryCassette);
        }

        return summaryCassettes;
    }

    /**
     * CashOut НЕ меняем.
     *
     * Оставляем расчет через уже подготовленные counters:
     *
     * transaction.getCasseteNominalCounter()
     *
     * Логика:
     *
     * Presented:
     *   любое ненулевое движение считаем выдачей.
     *
     * currencyExchange:
     *   отрицательный currentCount считаем выдачной частью обмена.
     *
     * Accepted:
     *   не участвует в CashOut.
     */
    private void fillCashOutOldWay(
            List<SummaryCassette> cassets,
            List<AtmEtlEncashTransactionsByIdDto> transactions
    ) {
        if (cassets == null || cassets.isEmpty()) {
            return;
        }

        if (transactions == null || transactions.isEmpty()) {
            return;
        }

        for (AtmEtlEncashTransactionsByIdDto transaction : transactions) {
            if (transaction == null || transaction.getCasseteNominalCounter() == null) {
                continue;
            }

            for (AtmEtlEncashCasseteNominalCounter counter : transaction.getCasseteNominalCounter()) {
                if (counter == null) {
                    continue;
                }

                Integer currentCount = nullToZero(counter.getCurrentCount());

                if (currentCount == 0) {
                    continue;
                }

                boolean isCashOutMovement = false;

                /*
                 * Старый смысл Presented:
                 * движение по Presented — это выдача.
                 */
                if (TRANSACTION_TYPE_PRESENTED.equals(transaction.getTt())) {
                    isCashOutMovement = true;
                }

                /*
                 * Для currencyExchange сохраняем уже рабочее поведение:
                 * отрицательный counter — выдачная часть обмена.
                 */
                if (TRANSACTION_TYPE_CURRENCY_EXCHANGE.equals(transaction.getTt())
                        && currentCount < 0) {
                    isCashOutMovement = true;
                }

                if (!isCashOutMovement) {
                    continue;
                }

                SummaryCassette summaryCassette =
                        findSummaryCassetteByCounter(cassets, counter);

                if (summaryCassette == null) {
                    continue;
                }

                Integer nominal = nullToZero(summaryCassette.getNominal());

                if (nominal == 0) {
                    continue;
                }

                Integer cashoutSum = Math.abs(currentCount) * nominal;

                summaryCassette.setCashoutSum(
                        nullToZero(summaryCassette.getCashoutSum()) + cashoutSum
                );
            }
        }
    }

    /**
     * CashIn считаем по дельтам CashInCount:
     *
     * cashInDelta = after.CashInCount - before.CashInCount
     *
     * Это защищает от ошибки, когда в CashInSum попадают
     * накопленные купюры, не относящиеся к транзакциям.
     */
    private void fillCashInByCashInDelta(
            List<SummaryCassette> cassets,
            List<AtmEtlEncashTransactionsByIdDto> transactions
    ) {
        if (cassets == null || cassets.isEmpty()) {
            return;
        }

        if (transactions == null || transactions.isEmpty()) {
            return;
        }

        for (AtmEtlEncashTransactionsByIdDto transaction : transactions) {
            if (transaction == null) {
                continue;
            }

            List<LbEtlEncashCassetInTransactionDto> cassetsBefore =
                    getCassetsList(getCassetsBeforeTransData(transaction));

            List<LbEtlEncashCassetInTransactionDto> cassetsAfter =
                    getCassetsList(getCassetsAfterTransData(transaction));

            if (cassetsAfter.isEmpty()) {
                continue;
            }

            /*
             * Идем от after, потому что возможен кейс:
             *
             * beforeNominals = 0
             * afterNominals  = 1
             *
             * Это первая принятая купюра по номиналу.
             */
            for (LbEtlEncashCassetInTransactionDto cassetAfter : cassetsAfter) {
                if (cassetAfter == null) {
                    continue;
                }

                normalizeNominals(cassetAfter);

                if (cassetAfter.getNominals().isEmpty()) {
                    continue;
                }

                LbEtlEncashCassetInTransactionDto cassetBefore =
                        findSameCassette(cassetsBefore, cassetAfter);

                if (cassetBefore != null) {
                    normalizeNominals(cassetBefore);
                }

                for (Nominal nominalAfter : cassetAfter.getNominals()) {
                    if (nominalAfter == null) {
                        continue;
                    }

                    Nominal nominalBefore = null;

                    if (cassetBefore != null) {
                        nominalBefore =
                                findNominalById(
                                        cassetBefore.getNominals(),
                                        nominalAfter.getNominalId()
                                );
                    }

                    SummaryCassette summaryCassette =
                            findSummaryCassetteByTransactionNominal(
                                    cassets,
                                    cassetAfter,
                                    nominalAfter
                            );

                    if (summaryCassette == null) {
                        continue;
                    }

                    Integer nominalValue = nullToZero(summaryCassette.getNominal());

                    if (nominalValue == 0) {
                        continue;
                    }

                    /*
                     * Основной расчет CashIn:
                     *
                     * after.CashInCount - before.CashInCount
                     */
                    Integer cashInDelta =
                            getCashInCount(nominalAfter) - getCashInCount(nominalBefore);

                    if (cashInDelta > 0) {
                        summaryCassette.setCashinSum(
                                nullToZero(summaryCassette.getCashinSum())
                                        + cashInDelta * nominalValue
                        );

                        continue;
                    }

                    /*
                     * Fallback для старых/особых ОС.
                     *
                     * Если CashInCount не заполнен,
                     * но это Accepted и видно увеличение CurrentCount,
                     * считаем это приемом.
                     *
                     * Важно:
                     * этот fallback не трогает CashOut.
                     */
                    if (TRANSACTION_TYPE_ACCEPTED.equals(transaction.getTt())) {
                        Integer currentDelta =
                                getCurrentCount(nominalAfter) - getCurrentCount(nominalBefore);

                        if (currentDelta > 0) {
                            summaryCassette.setCashinSum(
                                    nullToZero(summaryCassette.getCashinSum())
                                            + currentDelta * nominalValue
                            );
                        }
                    }
                }
            }
        }
    }

    /**
     * После раздельного расчета CashOut и CashIn
     * пересчитываем остаток:
     *
     * RemainSum = InitialSum - CashoutSum + CashinSum
     */
    private void recalculateRemain(List<SummaryCassette> cassets) {
        if (cassets == null || cassets.isEmpty()) {
            return;
        }

        for (SummaryCassette summaryCassette : cassets) {
            if (summaryCassette == null) {
                continue;
            }

            Integer initialSum = nullToZero(summaryCassette.getInitialSum());
            Integer cashoutSum = nullToZero(summaryCassette.getCashoutSum());
            Integer cashinSum = nullToZero(summaryCassette.getCashinSum());

            summaryCassette.setRemainSum(initialSum - cashoutSum + cashinSum);
        }
    }

    /**
     * Ищем SummaryCassette по данным Nominal из cassettes_after:
     *
     * - Slot;
     * - Nominal;
     * - CurrencyCode.
     */
    private SummaryCassette findSummaryCassetteByTransactionNominal(
            List<SummaryCassette> cassets,
            LbEtlEncashCassetInTransactionDto cassetAfter,
            Nominal nominal
    ) {
        if (cassets == null || cassets.isEmpty()) {
            return null;
        }

        Integer transactionNominal =
                dictionary.getOsNominalValue(nominal.getNominalId());

        Integer transactionCurrencyCode =
                dictionary.getCurrencyCode(nominal.getNominalId());

        for (SummaryCassette summaryCassette : cassets) {
            if (summaryCassette == null) {
                continue;
            }

            if (!safeEquals(summaryCassette.getSlot(), cassetAfter.getSlot())) {
                continue;
            }

            if (transactionNominal != null
                    && !transactionNominal.equals(summaryCassette.getNominal())) {
                continue;
            }

            if (transactionCurrencyCode != null
                    && !transactionCurrencyCode.equals(summaryCassette.getCurrencyCode())) {
                continue;
            }

            return summaryCassette;
        }

        return null;
    }

    /**
     * Ищем SummaryCassette по уже рассчитанному counter:
     *
     * - Slot;
     * - Nominal;
     * - CurrencyCode.
     */
    private SummaryCassette findSummaryCassetteByCounter(
            List<SummaryCassette> cassets,
            AtmEtlEncashCasseteNominalCounter counter
    ) {
        if (cassets == null || cassets.isEmpty() || counter == null) {
            return null;
        }

        Integer counterNominal =
                dictionary.getOsNominalValue(counter.getNominalId());

        Integer counterCurrencyCode =
                dictionary.getCurrencyCode(counter.getNominalId());

        for (SummaryCassette summaryCassette : cassets) {
            if (summaryCassette == null) {
                continue;
            }

            if (!safeEquals(summaryCassette.getSlot(), counter.getSlot())) {
                continue;
            }

            if (counterNominal != null
                    && !counterNominal.equals(summaryCassette.getNominal())) {
                continue;
            }

            if (counterCurrencyCode != null
                    && !counterCurrencyCode.equals(summaryCassette.getCurrencyCode())) {
                continue;
            }

            return summaryCassette;
        }

        return null;
    }

    private LbEtlEncashCassetInTransactionDto findSameCassette(
            List<LbEtlEncashCassetInTransactionDto> cassettes,
            LbEtlEncashCassetInTransactionDto target
    ) {
        if (cassettes == null || cassettes.isEmpty() || target == null) {
            return null;
        }

        for (LbEtlEncashCassetInTransactionDto cassette : cassettes) {
            if (cassette == null) {
                continue;
            }

            if (safeEquals(cassette.getCassetteId(), target.getCassetteId())
                    && safeEquals(cassette.getSlot(), target.getSlot())) {
                return cassette;
            }
        }

        return null;
    }

    private Nominal findNominalById(
            List<Nominal> nominals,
            Integer nominalId
    ) {
        if (nominals == null || nominals.isEmpty()) {
            return null;
        }

        for (Nominal nominal : nominals) {
            if (nominal == null) {
                continue;
            }

            if (safeEquals(nominal.getNominalId(), nominalId)) {
                return nominal;
            }
        }

        return null;
    }

    private LbEtlEncashCassetsTransactionsJsonDto getCassetsBeforeTransData(
            AtmEtlEncashTransactionsByIdDto transaction
    ) {
        return lbEncashJsonParser.parse(
                correctTransJson(transaction.getCassettesBeforeJson()),
                LbEtlEncashCassetsTransactionsJsonDto.class
        );
    }

    private LbEtlEncashCassetsTransactionsJsonDto getCassetsAfterTransData(
            AtmEtlEncashTransactionsByIdDto transaction
    ) {
        return lbEncashJsonParser.parse(
                correctTransJson(transaction.getCassettesAfterJson()),
                LbEtlEncashCassetsTransactionsJsonDto.class
        );
    }

    private List<LbEtlEncashCassetInTransactionDto> getCassetsList(
            LbEtlEncashCassetsTransactionsJsonDto dto
    ) {
        if (dto == null || dto.getCassetsTransactionsJson() == null) {
            return new ArrayList<>();
        }

        return dto.getCassetsTransactionsJson();
    }

    private String correctTransJson(String json) {
        if (json == null || json.trim().isEmpty() || "null".equalsIgnoreCase(json.trim())) {
            return "{\"CassetsTransactions\":[]}";
        }

        return "{\"CassetsTransactions\":" + json + "}";
    }

    private void normalizeNominals(LbEtlEncashCassetInTransactionDto casset) {
        if (casset.getNominals() == null) {
            casset.setNominals(new ArrayList<>());
        }
    }

    private Integer getCashInCount(Nominal nominal) {
        if (nominal == null) {
            return 0;
        }

        return nullToZero(nominal.getCashInCount());
    }

    private Integer getCurrentCount(Nominal nominal) {
        if (nominal == null) {
            return 0;
        }

        return nullToZero(nominal.getCurrentCount());
    }

    private boolean safeEquals(Object first, Object second) {
        if (first == null) {
            return second == null;
        }

        return first.equals(second);
    }

    private Integer nullToZero(Integer value) {
        return value == null ? 0 : value;
    }
}
